#!/usr/bin/env bash
#
# Hanif CLI - main entry point
#
# This file is intentionally small. It is responsible for:
#   1. Resolving its own location (so the CLI works when symlinked).
#   2. Loading shared utilities and the command registry.
#   3. Sourcing every command file in ``lib/commands/`` (each file
#      self-registers via ``register_command``).
#   4. Dispatching the requested command.
#
# Adding a new command does NOT require editing this file. Drop a new
# ``lib/commands/<name>.sh`` that calls ``register_command`` and defines the
# handler — it will be picked up automatically. See CONTRIBUTING.md.

set -euo pipefail

# ---------------------------------------------------------------------------
# Locate the script directory (handles symlink chains robustly).
# ---------------------------------------------------------------------------
_resolve_script_dir() {
  local source="${BASH_SOURCE[0]}"
  while [[ -L "$source" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd
}

SCRIPT_DIR="$(_resolve_script_dir)"

# Library paths (exported so sourced files can locate siblings reliably).
export LIB_DIR="${SCRIPT_DIR}/../lib"
export COMMANDS_DIR="${LIB_DIR}/commands"
export UTILS_DIR="${LIB_DIR}/utils"
export FUNCTIONS_DIR="${LIB_DIR}/functions"

# CLI version — single source of truth.
VERSION="0.4.0"
export VERSION

# ---------------------------------------------------------------------------
# Load shared utilities and the command registry.
# ---------------------------------------------------------------------------
# shellcheck source=../lib/utils/common.sh
source "${UTILS_DIR}/common.sh"
# shellcheck source=../lib/registry.sh
source "${LIB_DIR}/registry.sh"
# shellcheck source=../lib/utils/update-check.sh
source "${UTILS_DIR}/update-check.sh"

# ---------------------------------------------------------------------------
# Auto-discover and source every command file. Each file calls
# ``register_command`` to make itself known to the dispatcher.
# ---------------------------------------------------------------------------
_load_commands() {
  local file
  shopt -s nullglob
  for file in "${COMMANDS_DIR}"/*.sh; do
    # shellcheck disable=SC1090
    source "$file"
  done
  shopt -u nullglob
}
_load_commands

# ---------------------------------------------------------------------------
# Top-level usage screen.
# ---------------------------------------------------------------------------
show_usage() {
  cat <<EOF
┌─────────────────────────────────────────────┐
│              Hanif CLI v${VERSION}$(printf '%*s' $((20 - ${#VERSION})) '')│
└─────────────────────────────────────────────┘

Simple, extensible CLI for daily workflows

Usage: hanif <command> [options]

Git Commands:
  sync                Full sync (update, rebase, clean)
  nf "description"    Create feature branch
  up                  Update main branch
  upall               Update all branches
  clean               Delete branches removed from remote
  rb <branch>         Rebase onto branch
  pull                Fetch all + pull
  st                  Git status
  amend ["message"]   Amend last commit with current changes
  squash [count]      Interactive commit squashing (default: 20)
  gi <path>           Add to .gitignore & remove from tracking

Other Commands:
  bv [subcommand]     Version bumping (bump2version compatible)
  svg <subcommand>    SVG to PNG conversion
  self-update         Update Hanif CLI to latest version
  help [command]      Show help
  version             Show version

Examples:
  hanif sync
  hanif nf "add feature"
  hanif up
  hanif squash 5
  hanif svg chrome icon.svg
  hanif help git
EOF
}

# ---------------------------------------------------------------------------
# Main dispatcher.
# ---------------------------------------------------------------------------
main() {
  if [[ $# -eq 0 ]]; then
    show_usage
    return 0
  fi

  local command="$1"
  shift

  # Built-in pseudo-commands (deliberately not in the registry).
  case "$command" in
    help|--help|-h)
      show_help "$@"
      return 0
      ;;
    version|--version|-v)
      echo "Hanif CLI v${VERSION}"
      return 0
      ;;
  esac

  if registry_has "$command"; then
    dispatch_command "$command" "$@"
    return $?
  fi

  error "Unknown command: $command"
  echo ""
  show_usage
  return 1
}

# Run the dispatcher and remember its exit code so the trailing update check
# does not mask command failures.
main "$@"
_hanif_exit=$?

# Background update check (best effort, never affects the run's exit code).
if [[ -z "${HANIF_SKIP_UPDATE_CHECK:-}" ]]; then
  check_for_updates || true
fi

exit "$_hanif_exit"
